; The same as world_fast.v.pica, and the sun's mask laid over the ground (texture coordinate 2): for the chunks that have one
; (gfx_c3d.cpp: PROGRAM_FAST_SUN). Two instructions more a vertex, so the chunks without one keep the shorter entry.
; The fast vertex shader for the static world (PICA200, assembled with picasso).
; Entry `fastmain` of the same shbin as the full shader (world_full.v.pica,
; entry `main`); the program uses it for every world draw that is neither a
; character nor a swaying material, and for the overlay. 19 instructions, no
; branches (the full one: 30, with three of them).
;
; What makes it short:
;   - one matrix, mvp = projection x modelView, for the position;
;   - the fog factor is a single dp4 with fogRow before the clamp;
;   - the daylight term needs no 1/255 multiplication of its own:
;       light = rgb * (1/255 + weight * lightK), lightK = (dayLight - 1) / 255 / 255;
;   - the occlusion needs no floor: a vertex of a material that does not sway has
;     the occlusion alone in w (the sway bits are in the vertices of the materials
;     the full shader draws), so fract(w / 256) = w / 256 and aoK = strength / 256.
; See world.v.pica for what the vertex holds and how the position is made exact.

.fvec mvp[4]        ; projection x modelView (worked out on the CPU), rows
.fvec fogRow        ; fog factor before clamping = dp4(fogRow, position relative to the lattice point)
.fvec chunk         ; xyz = origin relative to the eye's lattice point, w = position step
.fvec params        ; x = uv scale, y = 1/255, z = fogA, w = fogB (the fog already is in fogRow; kept for the uv scale)
.fvec dayDelta      ; xyz = dayLight - 1
.fvec texOffset     ; xy = texture scroll offset; zw = where the sun's mask starts (texture 2)
.fvec skinLight     ; xyz = light on the character
.fvec bones[78]     ; 26 bones, three rows of a 3x4 matrix each
.fvec fx            ; Graphics+: xy = wind (cm per step of sway, times 4), z = wave phase, w = occlusion strength
.fvec lightK        ; xyz = (dayLight - 1) / 255 / 255: the fast shader's daylight term
.fvec aoK           ; x = occlusion strength / 256: the fast shader's occlusion term; yz = the sun's mask per cm of x, z
.fvec wave          ; (water waves; used by the full entry only)
.bool skinned
.bool windy
.bool fading
.bool wavy          ; Graphics+: the water's waves (world_full.v.pica only)

.constf consts(0.0, 1.0, 0.0, 0.0)
.alias zero consts.xxxx
.alias one  consts.yyyy

.out outpos position
.out outtc0 texcoord0
.out outclr color
.out outtc2 texcoord2

.alias inpos v0
.alias intc  v1
.alias inclr v2

.entry fastsun
.proc fastsun
	; r0 = (position relative to the eye's lattice point, 1)
	mul r0.xyz, chunk.www, inpos
	add r0.xyz, chunk.xyz, r0.xyz
	mov r0.w,   one

	; Graphics+ sun's shadow: texture 2 lies flat over the ground, (x, z) * aoK.yz + texOffset.zw (gfx_c3d.cpp updateSun)
	mul r1.xy, aoK.yz, r0.xz
	add outtc2.xy, texOffset.zw, r1.xy

	dp4 outpos.x, mvp[0], r0
	dp4 outpos.y, mvp[1], r0
	dp4 outpos.z, mvp[2], r0
	dp4 outpos.w, mvp[3], r0

	; fog factor, clamped, straight into the alpha
	dp4 r3.x, fogRow, r0
	max r3.x, zero, r3.x
	min outclr.w, one, r3.x

	mul r2, params.xxxx, intc
	add outtc0, texOffset, r2

	; light = rgb * (1/255 + weight * lightK)
	mul r5.xyz, lightK, inclr.www
	add r5.xyz, params.yyy, r5.xyz
	mul r4.xyz, inclr, r5.xyz
	; occlusion: * (1 - w * aoK)
	mul r9.x, aoK.x, inpos.w
	add r9.x, one, -r9.x
	mul outclr.xyz, r4.xyz, r9.xxx

	end
.end
