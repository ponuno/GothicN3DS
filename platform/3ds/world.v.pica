; World geometry vertex shader (PICA200, assembled with picasso).
;
; Input is the 16-byte WorldVertex exactly as it sits in data.pak:
;   v0  short4  quantised position (w is padding)
;   v1  short2  fixed-point texture coordinate
;   v2  ubyte4  rgb = baked light, a = daylight weight (255 outdoors, 0 indoors)
; modelView already contains the chunk origin and position scale.
;
; Light:  rgb * lerp(1, dayLight, weight); dayDelta holds dayLight - 1.
; Fog:    linear, per vertex: factor = clamp(fogA - viewZ * fogB, 0, 1), 1 = clear.
;         The factor travels in the colour alpha and is applied by the second
;         TexEnv stage (see gfx_c3d.cpp). The sky pass sets fogA = 1, fogB = 0.

.fvec projection[4], modelView[4]
.fvec params        ; x = uv scale, y = 1/255, z = fogA, w = fogB
.fvec dayDelta      ; xyz = dayLight - 1

.constf consts(0.0, 1.0, 0.0, 0.0)
.alias zero consts.xxxx
.alias one  consts.yyyy

.out outpos position
.out outtc0 texcoord0
.out outclr color

.alias inpos v0
.alias intc  v1
.alias inclr v2

.proc main
	; r0 = (position, 1)
	mov r0.xyz, inpos
	mov r0.w,   one

	; r1 = view-space position
	dp4 r1.x, modelView[0], r0
	dp4 r1.y, modelView[1], r0
	dp4 r1.z, modelView[2], r0
	dp4 r1.w, modelView[3], r0

	dp4 outpos.x, projection[0], r1
	dp4 outpos.y, projection[1], r1
	dp4 outpos.z, projection[2], r1
	dp4 outpos.w, projection[3], r1

	mul r2, params.xxxx, intc
	mov outtc0, r2

	; fog factor
	mul r3.x, params.w, r1.z
	add r3.x, params.z, -r3.x
	max r3.x, zero, r3.x
	min r3.x, one,  r3.x

	; r4 = (light, weight), both 0..1
	mul r4, params.yyyy, inclr
	; r5 = 1 + weight * (dayLight - 1)
	mul r5.xyz, dayDelta, r4.www
	add r5.xyz, one, r5.xyz
	mul r4.xyz, r4.xyz, r5.xyz

	mov r4.w, r3.x
	mov outclr, r4

	end
.end
