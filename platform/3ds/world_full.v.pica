; World and character vertex shader, the full one (PICA200, assembled with picasso).
; Assembled together with world_fast.v.pica into one shbin (world_fast_shbin.h):
; two entry points of the same code blob, so switching between them costs no
; upload. This one (entry `main`, DVLE 0) draws what the fast one cannot:
; characters (skinned) and the world materials that sway in the wind. Everything
; else is drawn by `fastmain` in world_fast.v.pica.
; Both files declare the same uniforms in the same order, so they share locations.
;
; The difference from world.v.pica (kept for the fallback, ZL+ZR at start): the
; projection and the view are one matrix (mvp, multiplied on the CPU), and the
; fog factor comes from one dp4 with fogRow (the view depth's row, scaled by
; fogB, plus fogA): 4 + 4 + 4 instructions fewer. See world.v.pica for what the
; vertex holds, how the position is made exact, the light, and the wind.

.fvec mvp[4]        ; projection x modelView (worked out on the CPU), rows
.fvec fogRow        ; fog factor before clamping = dp4(fogRow, position relative to the lattice point)
.fvec chunk         ; xyz = origin relative to the eye's lattice point, w = position step
.fvec params        ; x = uv scale, y = 1/255, z = fogA, w = fogB (the fog already is in fogRow; kept for the uv scale)
.fvec dayDelta      ; xyz = dayLight - 1; w = the phase of water wave C at the chunk's origin (no free uniform)
.fvec texOffset     ; xy = texture scroll offset (zw must be 0)
.fvec skinLight     ; xyz = light on the character
.fvec bones[78]     ; 26 bones, three rows of a 3x4 matrix each
.fvec fx            ; Graphics+: xy = wind (cm per step of sway, times 4), z = wave phase, w = occlusion strength
.fvec lightK        ; xyz = (dayLight - 1) / 255 / 255: the fast shader's daylight term
.fvec aoK           ; x = occlusion strength / 256: the fast shader's occlusion term
.fvec wave          ; Graphics+ water: x = phase of wave A, y = phase of wave B (cycles, at the chunk's origin), z = height (cm), w = shading strength
.bool skinned
.bool windy
.bool fading        ; the dissolve (gfx::setFade): texture coordinate 1 is the place on the screen
.bool wavy          ; Graphics+: the water's waves (world_full.v.pica only)
.bool reflon        ; the water's reflection (world_full.v.pica only)

.constf consts(0.0, 1.0, 0.00390625, 0.00125) ; 0, 1, 1/256, k = 1/800 cm (gfx.h WIND_WAVE_PER_CM)
.constf noiseScale(15.0, 25.0, 0.00070144, 0.00086167) ; zw: wave B's kB per cm (the 96 constant registers are full); texels of the 8x8 noise per unit of x and y on the screen (as world_fade.v.pica)
; Water waves (gfx.h WAVE_*): two travelling waves of one swell, A along (0.8, 0.6) with a wavelength of 14 m and B along
; (0.6313, 0.7755) (14 degrees off A) with 9 m, so that they run together in long crests, not in bumps; the same smooth curve as the wind's, w = 4 x (1 - |x|) in -1..1, x = 2 fract(u) - 1.
.constf wc(4.0, 0.7, 0.3, 0.000118110)    ; 4, height share of A, of B, texture shift (repeats) per unit of w and step of weight (0.015 / 127)
.constf wkA(0.00057143, 0.00042857, 0.6, 0.4)     ; per cm along x and z; zw: how the slopes of A and B light the surface
.alias zero consts.xxxx
.alias one  consts.yyyy

.out outpos position
.out outtc0 texcoord0
.out outclr color
.out outtc1 texcoord1
; (fix138: no texcoord2 here. The full entry draws what sways and the water, which never take the sun's shadow
; (gfx_c3d.cpp gSunMaterialOk); its fifth output, added in fix131, is the prime suspect of the GPU hang of fix133 on the
; console: the world drawn with this entry hung, with the fast one it did not.)

.alias inpos v0
.alias intc  v1
.alias inclr v2

.entry main
.proc main
	; r0 = (position in chunk or model space, 1)
	mul r0.xyz, chunk.www, inpos
	mov r0.w,   one

	ifu skinned
		; r6, r7 = the position as each of the two bones sees it
		mova a0.xy, inclr.xy
		dp4 r6.x, bones[a0.x],   r0
		dp4 r6.y, bones[a0.x+1], r0
		dp4 r6.z, bones[a0.x+2], r0
		dp4 r7.x, bones[a0.y],   r0
		dp4 r7.y, bones[a0.y+1], r0
		dp4 r7.z, bones[a0.y+2], r0
		; r0 = r6 + (r7 - r6) * weight
		add r7.xyz, r7.xyz, -r6.xyz
		mul r8.x,   params.y, inclr.z
		mul r7.xyz, r7.xyz, r8.xxx
		add r0.xyz, r6.xyz, r7.xyz
	.end

	ifu windy
		; r9.y = the sway of this corner (the high byte of w)
		mul r9.x, consts.z, inpos.w
		flr r9.y, r9.x
		; r10.x = 2 fract(phase + k (x + z)) - 1
		add r10.x, r0.x, r0.z
		mul r10.x, consts.w, r10.x
		add r10.x, fx.z, r10.x
		flr r10.y, r10.x
		add r10.x, r10.x, -r10.y
		add r10.x, r10.x, r10.x
		add r10.x, -consts.y, r10.x
		; r10.x = x (1 - |x|) * sway
		max r10.y, r10.x, -r10.x
		add r10.y, consts.y, -r10.y
		mul r10.x, r10.x, r10.y
		mul r10.x, r10.x, r9.y
		mul r11.xy, fx.xy, r10.xx
		add r0.x, r0.x, r11.x
		add r0.z, r0.z, r11.y
	.end


	ifu wavy
		; r8.x = the corner's weight in steps, 0..127 (the high byte of w, the wind's place; the multiplications below by
		; wave.z, wave.w and wc.w are per step: the CPU divides by 127)
		mul r8.x, consts.z, inpos.w
		flr r8.x, r8.x
		; ---- wave A: xA = 2 fract(phaseA + kA . (x, z)) - 1 ----
		mul r9.x, wkA.x, r0.x
		mul r9.y, wkA.y, r0.z
		add r9.x, r9.x, r9.y
		add r9.x, wave.x, r9.x
		flr r9.y, r9.x
		add r9.x, r9.x, -r9.y
		add r9.x, r9.x, r9.x
		add r9.x, -consts.y, r9.x
		max r11.x, r9.x, -r9.x
		add r11.x, consts.y, -r11.x          ; edgeA = 1 - |xA|
		mul r12.x, r9.x, r11.x
		mul r12.x, wc.x, r12.x               ; wA = 4 xA edgeA
		; ---- wave B ----
		mul r10.x, noiseScale.z, r0.x
		mul r10.y, noiseScale.w, r0.z
		add r10.x, r10.x, r10.y
		add r10.x, wave.y, r10.x
		flr r10.y, r10.x
		add r10.x, r10.x, -r10.y
		add r10.x, r10.x, r10.x
		add r10.x, -consts.y, r10.x
		max r11.y, r10.x, -r10.x
		add r11.y, consts.y, -r11.y          ; edgeB
		mul r12.y, r10.x, r11.y
		mul r12.y, wc.x, r12.y               ; wB
		; ---- wave C: the cross-chop. kC = (kA.y, kA.x) / 0.7, so its direction is across A's and its wavelength is
		; 0.7 of A's (gfx.h WAVE_C_*). Its phase comes in dayDelta.w (the 96 constant registers are full: no uniform
		; of its own). ----
		rcp r13.y, wc.y
		mul r12.w, wkA.y, r13.y              ; kC.x
		mul r13.w, wkA.x, r13.y              ; kC.z
		mul r10.y, r12.w, r0.x
		mul r10.z, r13.w, r0.z
		add r10.y, r10.y, r10.z
		add r10.y, dayDelta.w, r10.y
		flr r10.z, r10.y
		add r10.y, r10.y, -r10.z
		add r10.y, r10.y, r10.y
		add r10.y, -consts.y, r10.y
		max r10.z, r10.y, -r10.y
		add r10.z, consts.y, -r10.z          ; edgeC
		mul r12.z, r10.y, r10.z
		mul r12.z, wc.x, r12.z               ; wC
		; height: height * weight * 0.7 * (0.7 wA + 0.3 wB + 0.3 wC), straight up
		mul r13.x, wc.y, r12.x
		mul r13.y, wc.z, r12.y
		add r13.x, r13.x, r13.y
		mul r13.y, wc.z, r12.z
		add r13.x, r13.x, r13.y
		mul r13.x, wc.y, r13.x               ; * 0.7 (the three shares then sum to 0.91)
		mul r13.y, wave.z, r8.x              ; height * weight, per step
		mul r13.x, r13.x, r13.y
		add r0.y, r0.y, r13.x
		; slopes: sA/sB/sC = 2 edge - 1 (the derivative of 4 x (1 - |x|) up to the factor 4)
		add r11.x, r11.x, r11.x
		add r11.x, -consts.y, r11.x
		add r11.y, r11.y, r11.y
		add r11.y, -consts.y, r11.y
		add r13.y, r10.z, r10.z
		add r13.y, -consts.y, r13.y
		; normal gradient: 4 * height * weight * (0.49 sA kA + 0.21 sB kB + 0.21 sC kC)
		mul r13.z, wave.z, r8.x
		mul r13.z, wc.x, r13.z               ; 4 * height * weight
		mul r14.y, wkA.x, r11.x
		mul r14.y, wc.y, r14.y
		mul r14.y, wc.y, r14.y               ; 0.49 sA kA.x
		mul r9.y, noiseScale.z, r11.y
		mul r9.y, wc.y, r9.y
		mul r9.y, wc.z, r9.y               ; 0.21 sB kB.x
		add r14.y, r14.y, r9.y
		mul r9.z, r12.w, r13.y
		mul r9.z, wc.y, r9.z
		mul r9.z, wc.z, r9.z               ; 0.21 sC kC.x
		add r14.y, r14.y, r9.z
		mul r14.y, r13.z, r14.y              ; slope along x
		mul r14.z, wkA.y, r11.x
		mul r14.z, wc.y, r14.z
		mul r14.z, wc.y, r14.z
		mul r9.y, noiseScale.w, r11.y
		mul r9.y, wc.y, r9.y
		mul r9.y, wc.z, r9.y
		add r14.z, r14.z, r9.y
		mul r9.z, r13.w, r13.y
		mul r9.z, wc.y, r9.z
		mul r9.z, wc.z, r9.z
		add r14.z, r14.z, r9.z
		mul r14.z, r13.z, r14.z              ; slope along z
		; the surface is lit by 1 + strength * (0.6 sA + 0.4 sB + 0.3 sC)
		mul r11.x, wkA.z, r11.x
		mul r11.y, wkA.w, r11.y
		add r11.x, r11.x, r11.y
		mul r13.y, wc.z, r13.y
		add r11.x, r11.x, r13.y
		mul r11.x, wave.w, r11.x
		mul r11.x, r11.x, r8.x
		add r14.x, consts.y, r11.x
		; the texture slides with the waves, as if seen through them (the long A and B swell; C is a lighting-only chop)
		mul r15.xy, wc.ww, r12.xy
		mul r15.xy, r15.xy, r8.xx
	.end

	; relative to the eye's lattice point
	add r0.xyz, chunk.xyz, r0.xyz

	ifu wavy
		; ---- light on the water: a soft Blinn-Phong glint and a Fresnel brightening. No fragment shader on the
		; PICA200: both are per vertex, from the analytic normal (-slopeX, 1, -slopeZ), and the texture combiner and
		; blending do the rest. The eye is the lattice anchor, so V = normalize(-P). skinLight.xyz is the unit vector
		; to the sun/moon, skinLight.w the glint strength (0: off). ----
		mov r12.w, r8.x                     ; keep the weight: r8 becomes the normal below
		mov r8.x, -r14.y
		mov r8.y, one
		mov r8.z, -r14.z
		dp3 r13.x, r8, r8
		rsq r13.x, r13.x
		mul r8.xyz, r8.xyz, r13.xxx          ; N
		mov r9.x, -r0.x
		mov r9.y, -r0.y
		mov r9.z, -r0.z
		dp3 r13.y, r9, r9
		rsq r13.y, r13.y
		mul r9.xyz, r9.xyz, r13.yyy          ; V
		mov r12.xyz, skinLight.xyz
		add r10.xyz, r9.xyz, r12.xyz
		dp3 r13.z, r10, r10
		rsq r13.z, r13.z
		mul r10.xyz, r10.xyz, r13.zzz        ; H
		dp3 r11.x, r8.xyz, r10.xyz
		max r11.x, zero, r11.x
		mul r11.y, r11.x, r11.x
		mul r11.y, r11.y, r11.y
		mul r11.y, r11.y, r11.y
		mul r11.y, r11.y, r11.y              ; (N.H)^16
		mul r11.y, skinLight.w, r11.y
		mul r14.w, wc.z, r11.y               ; glint, scaled by 0.3
		dp3 r11.z, r8.xyz, r9.xyz
		max r11.z, zero, r11.z
		add r11.z, one, -r11.z
		mul r12.x, r11.z, r11.z
		mul r12.x, r12.x, r12.x
		mul r12.x, r12.x, r11.z              ; (1 - N.V)^5
		mov r9.w, wc.x
		mul r10.w, consts.z, r9.w            ; F0 = 4/256 = 0.015625 (no free .constf: 96 registers are full)
		add r12.y, one, -r10.w               ; 1 - F0
		mul r12.x, r12.y, r12.x
		add r12.x, r10.w, r12.x              ; F0 + (1 - F0) t^5
		mul r13.w, skinLight.w, r12.x        ; Fresnel, scaled by the glint strength
		; Only the fine water that carries a wave weight gets the glint: the coarse pieces (weight 0) are flat, and a
		; broad highlight over them would be a flat sheet of light. (Weight is a step count, 0 or at least 1.)
		min r13.x, one, r12.w
		mul r14.w, r13.x, r14.w
		mul r13.w, r13.x, r13.w
	.end

	dp4 r6.x, mvp[0], r0
	dp4 r6.y, mvp[1], r0
	dp4 r6.z, mvp[2], r0
	dp4 r6.w, mvp[3], r0
	mov outpos, r6

	; texture coordinate 1: the dissolve's place on the screen; or, for the
	; water with the reflection on (reflon), its place in the reflection's
	; texture: the point mirrored in the plane of the water (y -> j - y, the
	; plane at aoK.w) and projected with the same mvp, divided by the depth
	; (rcp) - flat sampling follows; or nothing. reflon is only raised for
	; whole draws (the water that is not dissolving), so the three cases
	; here are exclusive, and the uniform's two tail components (lightK.w =
	; half, aoK.w = the plane) are set only by the reflection's own pass
	; (gfx_c3d.cpp); the fast entries read neither.
	; fix235: stage the chosen coordinate in r7 and emit outtc1 exactly once.
	; fix145 established that this output must be written whole on hardware;
	; unlike fix228, the first reflection implementation wrote it twice when
	; dissolving, even with reflon=false. Do not pre-clear the output register.
	mov r7, zero
	ifu fading
		rcp r7.x, r6.w
		mul r7.xy, r6.xy, r7.xx
		mul r7.xy, noiseScale.xy, r7.xy
		mov r7.zw, zero
	.end
	ifu reflon
		; The raw tiled copy keeps the framebuffer's GPU axes. Project into
		; those same axes, without the screen-capture transpose/flip.
		; Keep the source position separate from all dp4 destinations.
		mov r8, r0
		add r8.y, aoK.w, -r8.y
		dp4 r7.x, mvp[0], r8
		dp4 r7.y, mvp[1], r8
		dp4 r7.w, mvp[3], r8
		rcp r7.w, r7.w
		mul r7.xy, r7.xy, r7.ww
		mul r7.xy, lightK.ww, r7.xy
		add r7.xy, lightK.ww, r7.xy
		mov r7.zw, zero
	.end
	mov outtc1, r7

	mul r2, params.xxxx, intc
	add r2, texOffset, r2
	ifu wavy
		add r2.xy, r2.xy, r15.xy
	.end
	mov outtc0, r2

	; fog factor
	dp4 r3.x, fogRow, r0
	max r3.x, zero, r3.x
	min r3.x, one,  r3.x

	ifu skinned
		; light * shade
		mul r4.x,   params.y, inclr.w
		mul r4.xyz, skinLight.xyz, r4.xxx
	.else
		; r4 = (light, weight), both 0..1
		mul r4, params.yyyy, inclr
		; r5 = 1 + weight * (dayLight - 1)
		mul r5.xyz, dayDelta, r4.www
		add r5.xyz, one, r5.xyz
		mul r4.xyz, r4.xyz, r5.xyz
		; ambient occlusion: * (1 - fract(w / 256) * strength)
		mul r9.x, consts.z, inpos.w
		flr r9.y, r9.x
		add r9.x, r9.x, -r9.y
		mul r9.x, fx.w, r9.x
		add r9.x, consts.y, -r9.x
		mul r4.xyz, r4.xyz, r9.xxx
	.end
	ifu wavy
		mul r4.xyz, r4.xyz, r14.xxx
		; Fresnel: grazing facets catch more of the sky (1 + 0.3 F times), then the soft Blinn-Phong glint on top.
		; Both are 0 when the glint is off (skinLight.w = 0), so the cheap path is a multiply by one and adding zero.
		mul r5.y, wc.z, r13.w
		add r5.y, one, r5.y
		mul r4.xyz, r4.xyz, r5.yyy
		add r4.xyz, r4.xyz, r14.www
		; fix140, the sheen: water seen from afar mirrors the sky, close below it is dark and clear - a Fresnel by distance.
		; With the view depth d (r6.w, cm), f = t / (1 + t), t = d / 800 (consts.w): 0.1 at 1 m, 0.5 at 8 m, 0.8 at 32 m. It needs
		; no new uniform (the 96 constant registers are full, and picasso's table of global uniforms is full with 16 for each of
		; the six entries) and nothing from the camera's height. The colour goes wc.y + wkA.z f = 0.7 .. 1.3 times (the
		; hardware clamps what is over 1), and the fog factor is cut by wkA.w f, up to 0.4: the fog stage then blends that much of
		; the horizon's colour in - the sky in the water. (The constants are the waves' - 0.7, 0.6 and 0.4: change them
		; together with gfx.h WATER_SHEEN_*.) The `wavy` switch is on for all water cut in the grid, waves or none.
		mul r5.x, consts.w, r6.w
		add r5.y, one, r5.x
		rcp r5.y, r5.y
		mul r5.x, r5.x, r5.y
		mul r5.y, wkA.z, r5.x
		add r5.y, wc.y, r5.y
		mul r4.xyz, r4.xyz, r5.yyy
		mul r5.x, wkA.w, r5.x
		add r5.x, one, -r5.x
		mul r3.x, r3.x, r5.x
	.end

	mov r4.w, r3.x
	mov outclr, r4

	end
.end
