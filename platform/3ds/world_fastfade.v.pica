; The fast vertex shader with the dissolve (PICA200, assembled with picasso): entry `fadefast`, DVLE 2 of
; world_fast_shbin.h. The same as `fastmain` (world_fast.v.pica) plus texture coordinate 1, the place on the
; screen in texels of the 8x8 noise, for the alpha test of gfx::setFade (as world_fade.v.pica does it). The
; program takes it in place of `fastmain` when the dissolve is on: before fix85 the dissolve meant the old
; one-matrix-pair shader for everything (about 36 instructions a world vertex instead of 19; here 22).

.fvec mvp[4]        ; projection x modelView (worked out on the CPU), rows
.fvec fogRow        ; fog factor before clamping = dp4(fogRow, position relative to the lattice point)
.fvec chunk         ; xyz = origin relative to the eye's lattice point, w = position step
.fvec params        ; x = uv scale, y = 1/255, z = fogA, w = fogB (the fog already is in fogRow; kept for the uv scale)
.fvec dayDelta      ; xyz = dayLight - 1
.fvec texOffset     ; xy = texture scroll offset (zw must be 0)
.fvec skinLight     ; xyz = light on the character
.fvec bones[78]     ; 26 bones, three rows of a 3x4 matrix each
.fvec fx            ; Graphics+: xy = wind (cm per step of sway, times 4), z = wave phase, w = occlusion strength
.fvec lightK        ; xyz = (dayLight - 1) / 255 / 255: the fast shader's daylight term
.fvec aoK           ; x = occlusion strength / 256: the fast shader's occlusion term
.fvec wave          ; (water waves; used by the full entry only)
.bool skinned
.bool windy
.bool fading
.bool wavy          ; Graphics+: the water's waves (world_full.v.pica only)

.constf consts(0.0, 1.0, 0.0, 0.0)
.constf noiseScale(15.0, 25.0, 0.0, 0.0)
.alias zero consts.xxxx
.alias one  consts.yyyy

.out outpos position
.out outtc0 texcoord0
.out outclr color
.out outtc1 texcoord1

.alias inpos v0
.alias intc  v1
.alias inclr v2

.entry fadefast
.proc fadefast
	; r0 = (position relative to the eye's lattice point, 1)
	mul r0.xyz, chunk.www, inpos
	add r0.xyz, chunk.xyz, r0.xyz
	mov r0.w,   one

	dp4 r6.x, mvp[0], r0
	dp4 r6.y, mvp[1], r0
	dp4 r6.z, mvp[2], r0
	dp4 r6.w, mvp[3], r0
	mov outpos, r6

	; the dissolve: where on the screen, in texels of the noise (see world_fade.v.pica)
	ifu fading
		rcp r7.x, r6.w
		mul r7.xy, r6.xy, r7.xx
		mul r7.xy, noiseScale.xy, r7.xy
		mov r7.zw, zero
		mov outtc1, r7
	.else
		mov outtc1, zero
	.end

	; fog factor, clamped, straight into the alpha
	dp4 r3.x, fogRow, r0
	max r3.x, zero, r3.x
	min outclr.w, one, r3.x

	mul r2, params.xxxx, intc
	add outtc0, texOffset, r2

	; light = rgb * (1/255 + weight * lightK)
	mul r5.xyz, lightK, inclr.www
	add r5.xyz, params.yyy, r5.xyz
	mul r4.xyz, inclr, r5.xyz
	; occlusion: * (1 - w * aoK)
	mul r9.x, aoK.x, inpos.w
	add r9.x, one, -r9.x
	mul outclr.xyz, r4.xyz, r9.xxx

	end
.end
